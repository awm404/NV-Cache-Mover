<Application x:Class="NvidiaCacheMover.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 2026 Borderless Liquid Glass Palette (Translucent over Live DWM Acrylic) -->
        <SolidColorBrush x:Key="LiquidWindowTint" Color="#66070A10"/>

        <LinearGradientBrush x:Key="LiquidBentoFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#59222E42" Offset="0.0"/>
            <GradientStop Color="#3B121926" Offset="0.5"/>
            <GradientStop Color="#4C182334" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LiquidSheenOverlay" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
            <GradientStop Color="#05FFFFFF" Offset="0.28"/>
            <GradientStop Color="#00FFFFFF" Offset="0.65"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LiquidCardFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F202B3E" Offset="0.0"/>
            <GradientStop Color="#36151D2B" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LiquidCardHoverFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6E2B3A52" Offset="0.0"/>
            <GradientStop Color="#521D283B" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="LiquidInputFill" Color="#4D0D121B"/>
        <SolidColorBrush x:Key="NvGreen" Color="#8CE000"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AmberAccent" Color="#FBBF24"/>
        <SolidColorBrush x:Key="DangerAccent" Color="#FB7185"/>

        <LinearGradientBrush x:Key="NvCtaGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A3F01E" Offset="0.0"/>
            <GradientStop Color="#76B900" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NvCtaHoverGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B2F73E" Offset="0.0"/>
            <GradientStop Color="#84CC0E" Offset="1.0"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="NvGlowShadow" Color="#84D400" BlurRadius="22" ShadowDepth="0" Opacity="0.32"/>

        <!-- Luminous Liquid CTA Button (Glow isolated on background layer) -->
        <Style x:Key="PrimaryGlowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#070B03"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid">
                            <Border x:Name="GlowLayer"
                                    Background="{StaticResource NvCtaGradient}"
                                    CornerRadius="12"
                                    Effect="{StaticResource NvGlowShadow}"/>
                            <Border x:Name="SurfaceLayer"
                                    Background="{StaticResource NvCtaGradient}"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="12" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#38FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SurfaceLayer" Property="Background" Value="{StaticResource NvCtaHoverGradient}"/>
                                <Setter TargetName="GlowLayer" Property="Background" Value="{StaticResource NvCtaHoverGradient}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="GlowLayer" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Translucent Frosted Liquid Pill Button -->
        <Style x:Key="GlassPillButton" TargetType="Button">
            <Setter Property="Background" Value="#4D222E42"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="11"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="11" IsHitTestVisible="False" Background="{StaticResource LiquidSheenOverlay}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#702E3E58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D182130"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Chrome Caption Buttons -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Translucent Liquid Glass Pill Toggle Switch -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="22" Background="Transparent">
                            <Border x:Name="Track"
                                    CornerRadius="11"
                                    Background="#4D2A374D"/>
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Fill="#E2E8F0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#D976B900"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Translucent ScrollBar -->
        <Style TargetType="Thumb" x:Key="SlimScrollThumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd" Background="#2EFFFFFF" CornerRadius="3" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="#52FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
