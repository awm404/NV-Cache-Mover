<Window x:Class="NvidiaCacheMover.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NVIDIA Cache Mover"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="960"
        Height="800"
        MinWidth="840"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Translucent Liquid Glass Root over DWM Live Desktop Acrylic -->
    <Border x:Name="RootWindowBorder"
            Background="{StaticResource LiquidWindowTint}"
            BorderThickness="0">
        <Grid>
            <!-- Soft Liquid Caustics / Ambient Refraction Glows -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="600" Height="340" Canvas.Left="-140" Canvas.Top="-150">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2B76B900" Offset="0.0"/>
                            <GradientStop Color="#0076B900" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="520" Height="300" Canvas.Right="-120" Canvas.Top="-130">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1F38BDF8" Offset="0.0"/>
                            <GradientStop Color="#0038BDF8" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="560" Height="320" Canvas.Left="200" Canvas.Bottom="-180">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1810B981" Offset="0.0"/>
                            <GradientStop Color="#0010B981" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid Margin="24,0,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Frameless Translucent Header -->
                <Grid Grid.Row="0" Margin="0,2,0,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="30" Height="30" Margin="0,0,12,0">
                            <Border Background="{StaticResource NvCtaGradient}" CornerRadius="9" Effect="{StaticResource NvGlowShadow}"/>
                            <Border Background="{StaticResource NvCtaGradient}" CornerRadius="9">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 L13,2 Z" Fill="#080B06"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <Border CornerRadius="9" Background="{StaticResource LiquidSheenOverlay}" IsHitTestVisible="False"/>
                        </Grid>

                        <TextBlock Text="NVIDIA Cache Mover" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                        <Border Background="#3876B900" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LIQUID GLASS · NT LIVE" FontSize="11" FontWeight="SemiBold" Foreground="#B5F82A"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ShortcutBtn"
                                Style="{StaticResource GlassPillButton}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="ShortcutBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12,17 L12,22 M5,17 L19,17 L17,11 L17,5 L18,3 L6,3 L7,5 L7,11 Z"
                                              Stroke="#E2E8F0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Desktop Pin" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="RefreshBtn"
                                Style="{StaticResource GlassPillButton}"
                                Padding="12,6"
                                Margin="0,0,12,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="RefreshBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M21,12 C21,16.97 16.97,21 12,21 C7.03,21 3,16.97 3,12 C3,7.03 7.03,3 12,3 C15.3,3 18.19,4.78 19.75,7.43 M20,3 L20,8 L15,8"
                                              Stroke="#E2E8F0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Refresh" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource CaptionButton}" Click="MinimizeBtn_Click" ToolTip="Minimize">
                            <Rectangle Width="10" Height="1.5" RadiusX="0.75" RadiusY="0.75"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="MaximizeBtn_Click" ToolTip="Maximize / Restore">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource CaptionCloseButton}" Click="CloseBtn_Click" ToolTip="Close">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Width="10" Height="10" Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Liquid Glass Bento Hero Strip -->
                <Grid Grid.Row="1" Margin="0,6,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="252"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Liquid Glass Bento Card: Telemetry -->
                    <Grid Grid.Column="0">
                        <Border Background="{StaticResource LiquidBentoFill}" CornerRadius="18"/>
                        <Border Background="{StaticResource LiquidSheenOverlay}" CornerRadius="18" IsHitTestVisible="False"/>
                        <Grid Margin="20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource NvGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="CACHE FOOTPRINT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,12">
                                <TextBlock x:Name="TotalCacheHeroText" Text="0.00 GB" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Managed Shader &amp; Update Data" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                <Border Background="#4076B900" CornerRadius="7" Padding="9,4" Margin="0,0,6,0">
                                    <TextBlock x:Name="ActiveLinksChipText" Text="0/5 Linked" FontSize="11" FontWeight="SemiBold" Foreground="#B8FA32"/>
                                </Border>
                                <Border Background="#38FFFFFF" CornerRadius="7" Padding="9,4">
                                    <TextBlock Text="ZERO-REBOOT" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Grid>

                    <!-- Right Liquid Glass Bento Card: Volume Selector + Destination Input -->
                    <Grid Grid.Column="2">
                        <Border Background="{StaticResource LiquidBentoFill}" CornerRadius="18"/>
                        <Border Background="{StaticResource LiquidSheenOverlay}" CornerRadius="18" IsHitTestVisible="False"/>
                        <StackPanel Margin="20,16">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="DESTINATION VOLUME &amp; PATH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="Select any NTFS drive or browse a custom directory" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            </DockPanel>

                            <!-- Frosted Liquid Volume Cards -->
                            <ItemsControl x:Name="DriveCardsControl" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,10,4" Cursor="Hand" Click="DriveCard_Click" Tag="{Binding SuggestedPath}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="194">
                                                        <Border x:Name="CardBd"
                                                                Background="{StaticResource LiquidCardFill}"
                                                                CornerRadius="13"
                                                                Padding="14,10">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock x:Name="DriveTitle" Text="{Binding DriveLetter}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                                                    <TextBlock Text="{Binding VolumeName}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="7,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding FreeText}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,7"/>
                                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsedRatio, Mode=OneWay}" Height="4"
                                                                             Background="#40000000" Foreground="{StaticResource NvGreen}" BorderThickness="0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border CornerRadius="13" Background="{StaticResource LiquidSheenOverlay}" IsHitTestVisible="False"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CardBd" Property="Background" Value="{StaticResource LiquidCardHoverFill}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelectedDrive}" Value="True">
                                                            <Setter TargetName="CardBd" Property="Background" Value="#52305214"/>
                                                            <Setter TargetName="DriveTitle" Property="Foreground" Value="#B8FA32"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Translucent Liquid Command Input Bar -->
                            <Border Background="{StaticResource LiquidInputFill}" CornerRadius="12" Padding="13,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="2,0,10,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M22,19 C22,20.1 21.1,21 20,21 L4,21 C2.9,21 2,20.1 2,19 L2,5 C2,3.9 2.9,3 4,3 L9,3 L11,6 L20,6 C21.1,6 22,6.9 22,8 Z"
                                                  Stroke="#8CE000" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>

                                    <TextBox x:Name="TargetPathTextBox"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             Foreground="{StaticResource TextPrimary}"
                                             CaretBrush="{StaticResource NvGreen}"
                                             BorderThickness="0"
                                             FontFamily="Consolas, Segoe UI"
                                             FontSize="13"
                                             VerticalContentAlignment="Center"
                                             Padding="0,4"
                                             TextChanged="TargetPathTextBox_TextChanged"/>

                                    <Button x:Name="BrowseBtn" Grid.Column="2" Content="Browse" Style="{StaticResource GlassPillButton}" Padding="13,6" Margin="8,0,0,0" Click="BrowseBtn_Click"/>
                                    <Button x:Name="OpenDestBtn" Grid.Column="3" Content="Open" Style="{StaticResource GlassPillButton}" Padding="13,6" Margin="6,0,0,0" Click="OpenDestBtn_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Row 2: Translucent Toast Banner -->
                <Border x:Name="ToastBanner"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Background="#661D3610"
                        CornerRadius="12"
                        Padding="15,9"
                        Margin="0,0,0,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Cursor="Hand" Click="DismissToast_Click" Padding="6,0"/>
                        <Ellipse x:Name="ToastDot" Width="8" Height="8" Fill="{StaticResource NvGreen}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="ToastText" Text="" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- Row 3: Liquid Glass Cache Modules Container -->
                <Grid Grid.Row="3" Margin="0,0,0,14">
                    <Border Background="{StaticResource LiquidBentoFill}" CornerRadius="18"/>
                    <Border Background="{StaticResource LiquidSheenOverlay}" CornerRadius="18" IsHitTestVisible="False"/>

                    <Grid Margin="18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="2,0,4,10">
                            <TextBlock Text="MANAGED CACHE MODULES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Toggle All" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}" FontSize="12" Cursor="Hand" Click="ToggleAllBtn_Click"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <ItemsControl x:Name="CacheItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Border x:Name="ItemCard"
                                                    Background="{StaticResource LiquidCardFill}"
                                                    CornerRadius="13"
                                                    Padding="15,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Toggle Switch -->
                                                    <CheckBox Style="{StaticResource ModernToggleSwitch}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,14,0"/>

                                                    <!-- Liquid Squircle Icon -->
                                                    <Border Grid.Column="1"
                                                            Width="40"
                                                            Height="40"
                                                            CornerRadius="11"
                                                            Background="#4576B900"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,14,0">
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="{Binding IconData}"
                                                                      Stroke="#B8FA32"
                                                                      StrokeThickness="1.9"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>

                                                    <!-- Crisp Module Typography & Status -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#55422C0B"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLinked}" Value="True">
                                                                                <Setter Property="Background" Value="#4D264710"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding BadgeLabel}" FontSize="10" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource AmberAccent}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLinked}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#B8FA32"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,3" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding StatusText}" FontFamily="Consolas, Segoe UI" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Frosted Footprint Pill -->
                                                    <Border Grid.Column="3"
                                                            Background="#450A0E15"
                                                            CornerRadius="9"
                                                            Padding="13,7"
                                                            VerticalAlignment="Center"
                                                            Margin="14,0,0,0">
                                                        <TextBlock Text="{Binding SizeText}"
                                                                   FontFamily="Consolas, Segoe UI"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border CornerRadius="13" Background="{StaticResource LiquidSheenOverlay}" IsHitTestVisible="False"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemCard" Property="Background" Value="{StaticResource LiquidCardHoverFill}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Row 4: Action Dock + Neon Progress Bar -->
                <Grid Grid.Row="4" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="MoveAndLinkBtn"
                                Grid.Column="0"
                                Style="{StaticResource PrimaryGlowButton}"
                                Click="MoveAndLinkBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M10,13 C10.8,14.1 12.1,14.8 13.5,14.9 C14.9,15 16.3,14.5 17.3,13.5 L20.3,10.5 C22.2,8.5 22.2,5.4 20.3,3.5 C18.4,1.6 15.3,1.6 13.3,3.5 L11.6,5.2 M14,11 C13.2,9.9 11.9,9.2 10.5,9.1 C9.1,9 7.7,9.5 6.7,10.5 L3.7,13.5 C1.8,15.5 1.8,18.6 3.7,20.5 C5.6,22.4 8.7,22.4 10.7,20.5 L12.4,18.8"
                                              Stroke="#070B03" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Relocate &amp; Link Selected Modules"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CleanOtaBtn"
                                Grid.Column="1"
                                Style="{StaticResource GlassPillButton}"
                                Padding="16,11"
                                Margin="10,0,0,0"
                                Click="CleanOtaBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3,6 L21,6 M8,6 L8,4 C8,2.9 8.9,2 10,2 L14,2 C15.1,2 16,2.9 16,4 L16,6 M19,6 L18,20 C18,21.1 17.1,22 16,22 L8,22 C6.9,22 6,21.1 6,20 L5,6"
                                              Stroke="#E2E8F0" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Purge Installers"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="RestoreBtn"
                                Grid.Column="2"
                                Style="{StaticResource GlassPillButton}"
                                Padding="16,11"
                                Margin="10,0,0,0"
                                Click="RestoreBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3,12 C3,7.03 7.03,3 12,3 C16.97,3 21,7.03 21,12 C21,16.97 16.97,21 12,21 C9.2,21 6.7,19.7 5.05,17.7 M3,7 L3,12 L8,12"
                                              Stroke="#E2E8F0" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Restore to C:"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="2" ClipToBounds="True" Height="4" Margin="2,10,2,0" Background="#400A0E16">
                        <ProgressBar x:Name="ActionProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource NvGreen}"
                                     BorderThickness="0"/>
                    </Border>
                </Grid>

                <!-- Row 5: Translucent Liquid Glass Telemetry Console -->
                <Grid Grid.Row="5">
                    <Border Background="#4D0A0E16" CornerRadius="15"/>
                    <Border Background="{StaticResource LiquidSheenOverlay}" CornerRadius="15" IsHitTestVisible="False"/>
                    <Grid Margin="15,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="&gt;_ ENGINE TELEMETRY" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Clear" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}" FontSize="11" Cursor="Hand" Click="ClearLogBtn_Click"/>
                        </DockPanel>

                        <TextBox x:Name="LogTextBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="#CBD5E1"
                                 BorderThickness="0"
                                 FontFamily="Consolas, Segoe UI"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
